{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "terms/index.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "^/privacy/?$",
      "status": 302,
      "headers": {
        "Location": "https://giddy-gaura-998.notion.site/Privacy-Policy-401ad28bec5c80369f2bcac4f2652099"
      }
    },
    {
      "src": "^/terms/?$",
      "dest": "/terms/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.js"
    }
  ]
}
