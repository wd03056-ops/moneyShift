# Money Shift — 환경변수 템플릿
# 사용법:
#   1) 이 파일을 복사해 `.env` 로 저장한 뒤 값을 채웁니다. (`.env` 는 Git에 올리지 마세요)
#   2) Flutter는 기본적으로 `.env`를 자동 로드하지 않습니다.
#      로컬 실행 시 `--dart-define` 또는 IDE Run 설정으로 주입하세요.
#
# 예)
#   flutter run \
#     --dart-define=KAKAO_NATIVE_APP_KEY=... \
#     --dart-define=KAKAO_API_KEY=... \
#     --dart-define=API_BASE_URL=https://moneyshift.vercel.app

# -----------------------------------------------------------------------------
# Kakao
# -----------------------------------------------------------------------------
# 카카오 네이티브 앱 키 (로그인 · 딥링크 스킴)
KAKAO_NATIVE_APP_KEY=

# 카카오 REST API 키 (주소/장소 검색 등)
KAKAO_API_KEY=

# -----------------------------------------------------------------------------
# API (Vercel Express / 로컬)
# -----------------------------------------------------------------------------
# 앱이 호출할 API 절대 URL (비우면 디버그·릴리즈 기본값 사용)
API_BASE_URL=

# true 이면 로컬 Express(http://127.0.0.1:3000) 사용
USE_LOCAL_API=false

# 로컬 API 서버 포트 (api/local.js)
PORT=3000

# -----------------------------------------------------------------------------
# (선택) Firebase / 기타 — 필요 시 추가
# -----------------------------------------------------------------------------
# FIREBASE_API_KEY=
# FIREBASE_APP_ID=
# FIREBASE_MESSAGING_SENDER_ID=
# FIREBASE_PROJECT_ID=
